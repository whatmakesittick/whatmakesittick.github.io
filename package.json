{
  "name": "whatmakesittick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json && tsc -p mcp/tsconfig.json && vite build && npm run build:widget",
    "build:widget": "vite build -c mcp/widget/vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:embed": "playwright test -c mcp/tests/embed/playwright.config.ts",
    "smoke:stdio": "node mcp/scripts/smoke-stdio.ts",
    "test:widget": "playwright test -c mcp/tests/widget/playwright.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "mcp": "node mcp/server/node.ts",
    "mcp:stdio": "node mcp/server/node.ts --stdio",
    "dev:widget": "vite -c mcp/widget/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.10",
    "sirv": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "fft.js": "^4.0.4",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
